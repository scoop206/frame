[
  { "name": "local",
    "mode": "bare" },

  { "name": "server",
    "mode": "durable",
    "command": "${SERVER_CMD}",
    "env": ["PORT"] },

  { "name": "vite",
    "mode": "durable",
    "command": "npm run dev",
    "dir": "web",
    "env": ["${PORT_PREFIX}_VITE_PORT", "${PORT_PREFIX}_HMR_PORT"] },

  { "name": "ngrok",
    "mode": "prefill",
    "command": "ngrok http ${FRAME_VITE_PORT}" },

  { "name": "claude",
    "mode": "durable",
    "command": "claude ${FRAME_CLAUDE_FLAGS}",
    "focus": true }
]
