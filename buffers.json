[
  { "name": "local",
    "mode": "bare" },

  { "name": "server",
    "mode": "durable",
    "command": "${SERVER_CMD}",
    "env": ["PORT"] },

  { "name": "vite",
    "mode": "durable",
    "command": "npm run dev",
    "dir": "${VITE_DIR}",
    "env": ["FRAME_VITE_PORT", "FRAME_HMR_PORT"] },

  { "name": "ngrok",
    "mode": "prefill",
    "command": "ngrok http ${FRAME_VITE_PORT}" },

  { "name": "claude",
    "mode": "durable",
    "command": "claude ${FRAME_CLAUDE_FLAGS}",
    "focus": true }
]
