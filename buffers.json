[
  { "name": "local",
    "mode": "bare" },

  { "name": "server",
    "mode": "durable",
    "command": "${FRAME_SERVER_CMD}",
    "env": ["PORT"],
    "when": { "env": "FRAME_SERVER_CMD" } },

  { "name": "vite",
    "mode": "durable",
    "command": "npm run dev",
    "dir": "web",
    "env": ["${FRAME_PORT_PREFIX}_VITE_PORT", "${FRAME_PORT_PREFIX}_HMR_PORT"],
    "when": { "dir": "web" } },

  { "name": "ngrok",
    "mode": "prefill",
    "command": "ngrok http ${FRAME_VITE_PORT}",
    "when": { "env": "FRAME_VITE_PORT" } },

  { "name": "claude",
    "mode": "durable",
    "command": "claude --dangerously-skip-permissions",
    "focus": true }
]
