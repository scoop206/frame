---
// Minimal starter page. Replace with your own content, or drive pages from a
// data file with js-yaml (already a dependency) — the yaml-driven pattern this
// scaffold is tuned for.
const title = 'New Astro site';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Scaffolded by <code>frame init --type astrojs</code>.</p>
    </main>
  </body>
</html>
