#!/usr/bin/env zsh
# frame - an AI harness built on: zsh, ghostty, neovim, and claude code
#
# A frame is a terminal window running neovim as its buffer-management layer —
# running Claude with supporting service buffers and a terminal (local).
#
# Usage:
#
#     frame init [--force]              scaffold integration into a project;
#                                       --force re-syncs an out-of-date
#                                       .claude/settings.json (frame hooks only)
#
#     frame wt TOPIC                    create/reuse branch + worktree, boot it
#     frame wt                          boot the worktree you're already in
#     frame wt -d [-f] [TOPIC]          tear down a frame (default: current)
#
#     frame shell TOPIC                 minimal frame in ~/frames/TOPIC — no repo,
#                                       no branch, just the claude + local buffers
#     frame shell                       infer TOPIC from the cwd if it's a shell
#                                       frame dir, else mint a fresh dated one
#
#     frame spawn shell TOPIC [--req TEXT] [--timeout N] [--ephemeral]
#                                       boot a shell frame into a tab group
#
#     frame spawn wt TOPIC [--cwd PATH] [--req TEXT] [--timeout N]
#                                       boot a worktree frame into a tab group
#
#     frame ls                          list frames
#
#     frame view [TOPIC|NAME/TOPIC]     dump one frame's full state (default:
#                                       the frame you're in)
#
#     frame merge [TOPIC] [--push|--ff|-n]
#                                       merge TOPIC into main (default: current
#                                       branch)
#
#     frame claude [--timeout N] TEXT…  talk to THIS frame's own claude: type
#                                       TEXT into it and block until it answers,
#                                       then print the answer. Needs it idle;
#                                       refuses (exit 4) mid-turn
#
#     frame req TOPIC|NAME/TOPIC TEXT…  send a request to ANOTHER frame's Claude
#                                       (types TEXT into its prompt); arms a
#                                       one-shot reply to your inbox
#
#     frame inbox [--wait [--timeout N] [--count K]]
#                                       show + clear this frame's inbox;
#                                       --wait blocks until a message arrives
#
#     frame reply [TEXT…]               frames use to reply to last req
#
#     frame deliver TOPIC|NAME/TOPIC TEXT…
#                                       send a message to a frame's inbox
#
#     frame status [TEXT…]              append "- TEXT" to this frame's window
#                                       title (no TEXT restores the base title)
#
#     frame focus [TOPIC|NAME/TOPIC]    raise that frame's ghostty window
#                                       (default: the frame you're in)
#
#     frame notify                      set title to "waiting" + fire the
#                                       task-complete banner
#
#     frame services [up|down]          manage the shared postgres/minio stack
#
#     frame notification on|off|init    on|off: global switch;
#                                       init: build/repair the banner icon
#
#     frame yolo on|off                 master switch: claude in every frame
#                                       launches --dangerously-skip-permissions
#                                       (default off; bare form shows the state)
#
#     frame swarm [off|1|2|singularity] how much each frame's claude is told,
#                                       at session start, about being a frame:
#                                       0 off · 1 aware (identity + safe-action
#                                       rules) · 2 ask (+ query siblings) ·
#                                       singularity clamps to the highest built
#                                       (default off; bare form shows the level)
#
# Example:
#     cd $YOUR_GIT_REPO && frame init
#     frame wt TOPIC
set -euo pipefail

export FRAME_ROOT="${0:A:h:h}"
source "$FRAME_ROOT/lib/helpers.sh"
frame_rundir >/dev/null   # this session's runtime dir exists before any command writes into it

cmd="${1:-}"
if (( $# > 0 )); then shift; fi

case "$cmd" in
  wt|worktree)
    source "$FRAME_ROOT/commands/wt.sh" "$@"
    ;;
  ls|list)
    source "$FRAME_ROOT/commands/ls.sh" "$@"
    ;;
  init|shell|merge|services|status|notify|notification|focus|yolo|swarm|claude|req|reply|deliver|inbox|spawn|view)
    source "$FRAME_ROOT/commands/$cmd.sh" "$@"
    ;;
  notifier)
    # internal spelling of `frame notification init` — the banner-app build, run
    # by `frame init` as its own process (not in the usage text above)
    source "$FRAME_ROOT/commands/notifier.sh" "$@"
    ;;
  ""|-h|--help|help)
    # print the header comment block verbatim (stops at the first non-comment line)
    awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
    ;;
  *)
    echo "$X_MARK frame: unknown command '$cmd' (try: frame help)" >&2
    exit 2
    ;;
esac
