#!/usr/bin/env zsh
# frame — shared dev-workflow harness. Run from inside a project checkout.
#
# Usage:
#   frame init                 scaffold .frame/config.sh, gitignore
#                              .frame/local/, .claude/settings.json hooks
#   frame wt TOPIC             create/reuse branch TOPIC + worktree, boot it
#   frame wt                   boot the worktree you're already in
#   frame wt -d [-f] [TOPIC]   tear down a frame (defaults to the one you're in)
#   frame shell TOPIC          casual frame in ~/frames/TOPIC — no repo, no
#                              branch, just the claude + local buffers
#   frame merge [TOPIC] [--push|--ff|-n]   merge TOPIC (default: current branch)
#   frame services [up|down]   manage the shared postgres/minio stack
#   frame status [TEXT…]       append "- TEXT" to this frame's window title
#                              (no TEXT clears it back to name/topic)
#   frame notify               frame will send waiting notification
#   frame notification on|off|init   on|off: global switch
#                                    init: build/repair the banner icon
#   frame yolo on|off          master switch: claude in every frame launches
#                              with --dangerously-skip-permissions (default
#                              off; bare `frame yolo` shows the state)
#   frame focus [NAME/TOPIC]   raise that frame's ghostty window (default:
#                              the frame you're in)
#   (`worktree` is accepted as a synonym for `wt`)
#
# A frame is a terminal window running neovim as its buffer management layer
# (multiplexer). This is usually one buffer running Claude and then whatever
# else is appropriate. Frames assumes a 1:1:1 mapping between
# a frame:worktree:branch.
# `cd project && frame wt YOUR_TOPIC` once project is configured.
#
# Set project level config with `cd project && frame init`
set -euo pipefail

export FRAME_ROOT="${0:A:h:h}"
source "$FRAME_ROOT/lib/helpers.sh"

cmd="${1:-}"
if (( $# > 0 )); then shift; fi

case "$cmd" in
  wt|worktree)
    source "$FRAME_ROOT/commands/wt.sh" "$@"
    ;;
  init|shell|merge|services|status|notify|notification|focus|yolo)
    source "$FRAME_ROOT/commands/$cmd.sh" "$@"
    ;;
  notifier)
    # internal spelling of `frame notification init` — the banner-app build, run
    # by `frame init` as its own process (not in the usage text above)
    source "$FRAME_ROOT/commands/notifier.sh" "$@"
    ;;
  ""|-h|--help|help)
    sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "$X_MARK frame: unknown command '$cmd' (try: frame help)" >&2
    exit 2
    ;;
esac
