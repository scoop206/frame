#!/usr/bin/env zsh
# frame — shared dev-workflow harness. Run from inside a project checkout.
#
# Usage:
#   frame init                 scaffold .frame/config.sh, gitignore .frame/local/
#   frame wt TOPIC             create/reuse branch TOPIC + worktree, boot it
#   frame wt                   boot the worktree you're already in
#   frame wt -d TOPIC          quit its nvim, remove worktree, delete branch
#   frame wt -m [TOPIC] [...]  merge into main (delegates to `frame merge`)
#   frame merge [TOPIC] [--push|--ff|-n]   merge TOPIC (default: current branch)
#   frame deploy-sans-tests    trigger the deploy workflow with skip_tests=true
#   frame services [up|down]   manage the shared postgres/minio stack
#
# All work happens in topic worktrees ("framelets"). Each is self-sufficient —
# `frame wt` runs the project's stack_up, which is idempotent, so whichever
# framelet boots first brings up the world. The primary checkout is just the
# git anchor that topic branches merge back into; it never needs a dev session.
#
# Project config: .frame/config.sh (committed) / .frame/local/config.sh
# (gitignored, wins). See `frame init` for a starter template.
set -euo pipefail

export FRAME_ROOT="${0:A:h:h}"
source "$FRAME_ROOT/lib/helpers.sh"

cmd="${1:-}"
if (( $# > 0 )); then shift; fi

case "$cmd" in
  init|wt|merge|deploy-sans-tests|services)
    source "$FRAME_ROOT/commands/$cmd.sh" "$@"
    ;;
  ""|-h|--help|help)
    sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "✗ frame: unknown command '$cmd' (try: frame help)" >&2
    exit 2
    ;;
esac
