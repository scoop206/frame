#!/usr/bin/env zsh
# In-process tests of frame_clone_node_modules with fake npm/node functions:
# npm logs where it ran and "installs" by writing package.json into
# node_modules/installed-from, so a test can tell stale trees from fresh ones.
source "${${(%):-%x}:A:h:h}/helpers/harness.zsh"
export FRAME_ROOT="$FRAME_CHECKOUT"
source "$FRAME_ROOT/lib/helpers.sh"

node() { print v99; }
npm() {
  print -r -- "${PWD:A}" >> "$SANDBOX/npm.log"
  mkdir -p node_modules && cp package.json node_modules/installed-from
}

_setup() {
  # A primary at $MAIN_WT and a worktree dir at $SANDBOX/wt, same package.json.
  export MAIN_WT="$SANDBOX/main"
  mkdir -p "$MAIN_WT/.git" "$SANDBOX/wt"
  print '{"deps":"v1"}' > "$MAIN_WT/package.json"
  print '{"deps":"v1"}' > "$SANDBOX/wt/package.json"
  : > "$SANDBOX/npm.log"
}
_npm_runs() { grep -c . "$SANDBOX/npm.log" || true; }

test_stale_primary_is_reinstalled_before_clone() {
  _setup
  # Primary was installed from old deps and stamped back then (e.g. pre-upgrade).
  mkdir -p "$MAIN_WT/node_modules"
  print '{"deps":"v0"}' > "$MAIN_WT/node_modules/installed-from"
  print stale-stamp > "$MAIN_WT/node_modules/.deps-stamp"
  cd "$SANDBOX/wt"
  frame_clone_node_modules
  assert_eq "$(cat "$SANDBOX/npm.log")" "$MAIN_WT" "expected one install, in the primary only"
  assert_eq "$(cat node_modules/installed-from)" '{"deps":"v1"}'
  assert_eq "$(cat node_modules/.deps-stamp)" "$(_frame_deps_fingerprint "$MAIN_WT")"
}

test_unstamped_primary_is_reconciled() {
  _setup
  mkdir -p "$MAIN_WT/node_modules"   # installed by hand, never stamped
  cd "$SANDBOX/wt"
  frame_clone_node_modules
  assert_eq "$(_npm_runs)" 1
  assert_file_exists "$MAIN_WT/node_modules/.deps-stamp"
}

test_missing_primary_node_modules_installed() {
  _setup
  cd "$SANDBOX/wt"
  frame_clone_node_modules
  assert_eq "$(cat "$SANDBOX/npm.log")" "$MAIN_WT"
  assert_eq "$(cat node_modules/installed-from)" '{"deps":"v1"}'
}

test_fresh_primary_and_matching_worktree_is_noop() {
  _setup
  ( cd "$MAIN_WT" && frame_clone_node_modules )   # primary: install + stamp
  : > "$SANDBOX/npm.log"
  cd "$SANDBOX/wt"
  frame_clone_node_modules
  frame_clone_node_modules
  assert_eq "$(_npm_runs)" 0 "expected no installs once the primary is stamped"
  assert_dir_exists node_modules
}

test_worktree_with_different_deps_installs_in_worktree() {
  _setup
  ( cd "$MAIN_WT" && frame_clone_node_modules )
  : > "$SANDBOX/npm.log"
  print '{"deps":"v2"}' > "$SANDBOX/wt/package.json"
  cd "$SANDBOX/wt"
  frame_clone_node_modules
  assert_eq "$(cat "$SANDBOX/npm.log")" "$SANDBOX/wt"
  assert_eq "$(cat node_modules/installed-from)" '{"deps":"v2"}'
  assert_eq "$(cat "$MAIN_WT/node_modules/installed-from")" '{"deps":"v1"}' "primary untouched"
}

test_symlinked_worktree_node_modules_left_alone() {
  _setup
  ( cd "$MAIN_WT" && frame_clone_node_modules )
  : > "$SANDBOX/npm.log"
  print '{"deps":"v2"}' > "$SANDBOX/wt/package.json"
  ln -s "$MAIN_WT/node_modules" "$SANDBOX/wt/node_modules"
  cd "$SANDBOX/wt"
  frame_clone_node_modules
  assert_eq "$(_npm_runs)" 0
  assert_link_target node_modules "$MAIN_WT/node_modules"
}

test_lock_released() {
  _setup
  cd "$SANDBOX/wt"
  frame_clone_node_modules
  assert_dir_absent "$MAIN_WT/.git/frame-deps.lock"
}

run_tests "$0"
