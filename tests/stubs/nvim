#!/usr/bin/env zsh
# Test stub for nvim. `frame wt` ends in `exec nvim -S <layout>`, so in tests
# this stub BECOMES the frame process — its exit code is what frame returns.
#
# With FAKE_NVIM_LOG set: record how nvim was invoked (argv, cwd, the env
# frame exported) and exit 0.
# Without it: tripwire — no test should reach an editor launch unannounced.
# frame's remote-expr clients run `nvim --headless --server …` (headless so
# a piped-stdout nvim writes to stdout instead of /dev/tty and skips the
# terminal-capability probe). Peel a leading --headless so the RPC check
# below still sees --server as $1; the wt editor launch (`nvim -S …`) never
# passes it, so this is a no-op there.
[[ "${1:-}" == "--headless" ]] && shift
# RPC mode (frame status / notify / ls use `nvim --server SOCK --remote-expr EXPR`).
if [[ "${1:-}" == "--server" ]]; then
  _sock=$2
  _expr=${@[-1]}   # the expression is always the last arg
  # `frame ls` probes each socket with FrameInfo(). A test stands in for a live
  # session by planting a <sock>.info companion holding the answer; a socket
  # without one is "dead" — the query fails, exactly as a real unanswered
  # socket would, and ls skips it.
  case "$_expr" in
    # Teardown's pre-quit :qa! (frame wt -d, via --remote-send). A real nvim
    # unlinks its listen socket as it exits — model that so teardown's
    # socket-unlink poll completes instead of timing out. No exit: fall through
    # to the shared logging below so a FAKE_NVIM_LOG argv trace (frame shell -d)
    # and a FAKE_NVIM_EXPR_LOG expr trace (ordering vs the buffer-stop RPC) still
    # capture the call exactly as before.
    *qa!*) rm -f "$_sock"; _qa=1 ;;
    # The frame layer of `frame kv` lives in the session (FrameKv* in
    # layouts/session.lua). The stub keeps it in a <sock>.kv companion, in the
    # dump's own kind<TAB>key<TAB>value format; a <sock>.nokv companion makes the
    # session answer like an old layout without FrameKv* (RPC error).
    *FrameKvDump*)
      [[ -f "$_sock.nokv" ]] && exit 1
      [[ -f "$_sock.kv" ]] && print -rn -- "$(<$_sock.kv)"
      exit 0 ;;
    *FrameKvSet*)
      [[ -f "$_sock.nokv" ]] && exit 1
      [[ "$_expr" =~ "FrameKvSet\('([sn])','([a-z0-9_]+)','([0-9a-f]*)'\)" ]] || { print -rn -- bad; exit 0; }
      _kk=$match[1] _key=$match[2]
      _val=$(printf '%b' "$(print -rn -- "$match[3]" | sed 's/../\\x&/g')")
      _lines=()
      [[ -f "$_sock.kv" ]] && _lines=("${(@f)$(<$_sock.kv)}")
      _lines=(${_lines:#$_kk$'\t'$_key$'\t'*} "$_kk"$'\t'"$_key"$'\t'"$_val")
      print -rl -- "${(@o)_lines}" > "$_sock.kv"
      print -rn -- ok; exit 0 ;;
    *FrameKvUnset*)
      [[ -f "$_sock.nokv" ]] && exit 1
      [[ "$_expr" =~ "FrameKvUnset\('([sn])','([a-z0-9_]+)'\)" ]] || exit 1
      _lines=()
      [[ -f "$_sock.kv" ]] && _lines=("${(@f)$(<$_sock.kv)}")
      _kept=(${_lines:#$match[1]$'\t'$match[2]$'\t'*})
      if (( $#_kept == $#_lines )); then print -rn -- absent; exit 0; fi
      print -rl -- "${_kept[@]}" > "$_sock.kv"
      print -rn -- ok; exit 0 ;;
    # `frame kv --of` asks a session for its primary checkout. A <sock>.debug
    # companion holds the FrameDebug answer (key<TAB>value lines); without one
    # the RPC fails, as an old layout's would.
    *FrameDebug*)
      [[ -f "$_sock.debug" ]] && { cat "$_sock.debug"; exit 0; }; exit 1 ;;
    # `frame stop`: a <sock>.unsaved companion lists the session's unsaved file
    # buffers (the getbufinfo probe); <sock>.stopbufs holds how many terminal
    # buffers FrameStopBuffers signalled (default 0); FrameBusyBuffers says
    # they've all drained (0). All logged when a trace is wanted.
    *bufmodified*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      [[ -f "$_sock.unsaved" ]] && print -rn -- "$(<$_sock.unsaved)"
      exit 0 ;;
    *FrameStopBuffers*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      if [[ -f "$_sock.stopbufs" ]]; then print -rn -- "$(<$_sock.stopbufs)"
      elif [[ -n "${FAKE_NVIM_EXPR_RESULT+x}" ]]; then print -rn -- "$FAKE_NVIM_EXPR_RESULT"
      else print -rn -- 0; fi
      exit 0 ;;
    *FrameBusyBuffers*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      print -rn -- 0; exit 0 ;;
    *FrameInfo*)
      # A <sock>.hang companion stands in for an alive-but-unresponsive nvim:
      # the socket exists but the session never answers the RPC. Sleep well
      # past frame_rpc_expr's timeout so the caller must bound + skip us; a
      # real wedged frame would block here indefinitely. The client is killed
      # before this returns, so the exit code never matters.
      [[ -f "$_sock.hang" ]] && { sleep 30; exit 0; }
      [[ -f "$_sock.info" ]] && { cat "$_sock.info"; exit 0; }; exit 1 ;;
    # `frame spawn` polls FrameReady() while a worker boots. A test marks the
    # planted socket "booted" with a <sock>.ready companion; without one the
    # session answers 0 (still booting) and spawn keeps polling to its timeout.
    # A <sock>.menu companion answers 2: claude is up but a startup menu holds
    # the screen (not the input prompt), so spawn must keep waiting too.
    *FrameReady*)
      if [[ -f "$_sock.ready" ]]; then print -rn -- 1
      elif [[ -f "$_sock.menu" ]]; then print -rn -- 2
      else print -rn -- 0; fi
      exit 0 ;;
    # The claude broker (docs/claude-broker.md). Submit returns a request id
    # (FAKE_BROKER_SUBMIT, default 'r1'; 'FAIL' → RPC errors, as an old layout
    # would; or a verdict like 'no-claude-buffer'/'queue-full'). Await polls:
    # 'pending' for the first FAKE_NVIM_EXPR_EMPTY_POLLS calls, then
    # FAKE_BROKER_AWAIT (default 'done' = empty answer; set $'done\n<text>' for
    # a real one, or 'gone'). Cancel/Status echo ok / FAKE_BROKER_STATUS. All
    # logged when a trace is wanted, so a test can assert what was sent.
    *FrameBrokerSubmit*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      [[ "${FAKE_BROKER_SUBMIT:-}" == FAIL ]] && exit 1
      print -rn -- "${FAKE_BROKER_SUBMIT:-r1}"; exit 0 ;;
    *FrameBrokerAwait*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      if [[ -n "${FAKE_NVIM_EXPR_EMPTY_POLLS:-}" ]]; then
        _n=0
        [[ -f "${FAKE_NVIM_POLL_COUNT_FILE:?set with FAKE_NVIM_EXPR_EMPTY_POLLS}" ]] \
          && _n=$(<"$FAKE_NVIM_POLL_COUNT_FILE")
        _n=$((_n + 1))
        print -rn -- "$_n" > "$FAKE_NVIM_POLL_COUNT_FILE"
        (( _n <= FAKE_NVIM_EXPR_EMPTY_POLLS )) && { print -rn -- pending; exit 0; }
      fi
      print -rn -- "${FAKE_BROKER_AWAIT:-done}"; exit 0 ;;
    *FrameBrokerCancel*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      print -rn -- ok; exit 0 ;;
    *FrameBrokerStatus*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      print -rn -- "${FAKE_BROKER_STATUS:-}"; exit 0 ;;
    # `frame req status` / `inbox --wait --for` ask a TARGET what became of a
    # request: a <sock>.state companion holds FrameBrokerState's answer (e.g.
    # $'inflight\t420\tworking', 'gone'); without one the RPC fails, as an old
    # layout's would.
    *FrameBrokerState*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      [[ -f "$_sock.state" ]] && { print -rn -- "$(<$_sock.state)"; exit 0; }; exit 1 ;;
    # The sender's own outbox. Query: a <sock>.outbox companion holds the rows
    # (token<TAB>age<TAB>in_inbox<TAB>line); without one, each asked-for token
    # comes back untracked and not here. Add/Forget just log and say ok.
    *FrameOutboxQuery*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      [[ -f "$_sock.nooutbox" ]] && exit 1
      [[ -f "$_sock.outbox" ]] && { print -rn -- "$(<$_sock.outbox)"; exit 0; }
      _q=${${_expr#*FrameOutboxQuery\(\'}%\'\)*}
      _rows=()
      for _t in "${(@ps:\t:)_q}"; do [[ -n "$_t" ]] && _rows+=("$_t"$'\t\t0\t'); done
      print -rn -- "${(pj:\n:)_rows}"; exit 0 ;;
    *FrameOutboxAdd*|*FrameOutboxForget*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      print -rn -- ok; exit 0 ;;
    # bin/buf-preview.sh probes a buffer's type, then a terminal's line tail.
    # FAKE_NVIM_BUFTYPE answers the type probe ('' when unset — a normal file
    # buffer, exactly what getbufvar returns for one); FAKE_NVIM_BUFLINES_FILE's
    # contents stand in for the getbufline tail (absent → RPC error, as a
    # just-wiped buffer would). Both log to FAKE_NVIM_EXPR_LOG so a test can
    # assert which bufnr was queried.
    *getbufvar*buftype*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      print -rn -- "${FAKE_NVIM_BUFTYPE:-}"; exit 0 ;;
    *getbufline*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      [[ -f "${FAKE_NVIM_BUFLINES_FILE:-}" ]] && { cat "$FAKE_NVIM_BUFLINES_FILE"; exit 0; }
      exit 1 ;;
    # `frame notify` reads-and-clears this to skip the banner for brokered turns.
    # FAKE_BROKERED (default 0 = a human turn) stands in for the flag; a dedicated
    # case so it doesn't collide with the mute switch's FAKE_NVIM_EXPR_RESULT.
    *FrameTakeBrokeredFlag*) print -rn -- "${FAKE_BROKERED:-0}"; exit 0 ;;
    # `frame wt --from` probes this to gate the graceful handoff, then polls it
    # while the live source tidies up and retires itself. FAKE_CLAUDE_ALIVE_POLLS=N
    # reports alive (1) for the first N queries, then gone (0) — simulating the
    # source going down after the handoff nudge (count kept in the shared
    # FAKE_NVIM_POLL_COUNT_FILE). Without it, honor FAKE_NVIM_EXPR_RESULT like the
    # historical single-probe tests, or error like an old layout when it's unset.
    *FrameClaudeAlive*)
      [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
      if [[ -n "${FAKE_CLAUDE_ALIVE_POLLS:-}" ]]; then
        _n=0
        [[ -f "${FAKE_NVIM_POLL_COUNT_FILE:?set with FAKE_CLAUDE_ALIVE_POLLS}" ]] \
          && _n=$(<"$FAKE_NVIM_POLL_COUNT_FILE")
        _n=$((_n + 1))
        print -rn -- "$_n" > "$FAKE_NVIM_POLL_COUNT_FILE"
        (( _n <= FAKE_CLAUDE_ALIVE_POLLS )) && { print -rn -- 1; exit 0; }
        print -rn -- 0; exit 0
      fi
      [[ -n "${FAKE_NVIM_EXPR_RESULT+x}" ]] && { print -rn -- "$FAKE_NVIM_EXPR_RESULT"; exit 0; }
      exit 1 ;;
  esac
  # Optional expr trace: append every remote-expr issued, so a test can assert
  # what was actually sent (e.g. --count → FrameInboxDrainAtLeast, --for → the
  # tab-joined tokens in FrameInboxDrainFor, --id → the 3rd FrameInboxAdd arg).
  [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
  # Other exprs (frame status / notify / req / deliver / inbox …): a test opts in
  # via FAKE_NVIM_EXPR_RESULT, which becomes the answer to any such query. The
  # +x test means set-BUT-empty still answers (empty string) — an empty inbox
  # returns '' successfully, distinct from "unset" which falls through to the
  # tripwire like everything else.
  if [[ -n "${FAKE_NVIM_EXPR_RESULT+x}" ]]; then
    # FAKE_NVIM_EXPR_EMPTY_POLLS=N: answer '' for the first N queries (count
    # kept across invocations in FAKE_NVIM_POLL_COUNT_FILE) before serving the
    # result — lets a test watch `inbox --wait` genuinely poll before the mail
    # "arrives", instead of hitting it on the first drain.
    if [[ -n "${FAKE_NVIM_EXPR_EMPTY_POLLS:-}" ]]; then
      _n=0
      [[ -f "${FAKE_NVIM_POLL_COUNT_FILE:?set with FAKE_NVIM_EXPR_EMPTY_POLLS}" ]] \
        && _n=$(<"$FAKE_NVIM_POLL_COUNT_FILE")
      _n=$((_n + 1))
      print -rn -- "$_n" > "$FAKE_NVIM_POLL_COUNT_FILE"
      (( _n <= FAKE_NVIM_EXPR_EMPTY_POLLS )) && exit 0
    fi
    print -rn -- "$FAKE_NVIM_EXPR_RESULT"
    exit 0
  fi
fi
if [[ -n "${FAKE_NVIM_LOG:-}" ]]; then
  {
    print -r -- "argv: $*"
    print -r -- "cwd: $PWD"
    env | grep -E '^(FRAME_|PORT=|PORT_PREFIX=|SERVER_CMD=|[A-Z0-9_]+_(API|VITE|HMR)_PORT=)' | sort
  } > "$FAKE_NVIM_LOG"
  exit 0
fi
# A :qa! with nothing else to record is just a quit that worked (frame stop).
[[ -n "${_qa:-}" ]] && exit 0
print -r -- "✗ test stub: unexpected nvim invocation: nvim $*" >&2
exit 97
