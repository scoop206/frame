#!/usr/bin/env zsh
# Test stub for nvim. `frame wt` ends in `exec nvim -S <layout>`, so in tests
# this stub BECOMES the frame process — its exit code is what frame returns.
#
# With FAKE_NVIM_LOG set: record how nvim was invoked (argv, cwd, the env
# frame exported) and exit 0.
# Without it: tripwire — no test should reach an editor launch unannounced.
# frame's remote-expr clients run `nvim --headless --server …` (headless so
# a piped-stdout nvim writes to stdout instead of /dev/tty and skips the
# terminal-capability probe). Peel a leading --headless so the RPC check
# below still sees --server as $1; the wt editor launch (`nvim -S …`) never
# passes it, so this is a no-op there.
[[ "${1:-}" == "--headless" ]] && shift
# RPC mode (frame status / notify / ls use `nvim --server SOCK --remote-expr EXPR`).
if [[ "${1:-}" == "--server" ]]; then
  _sock=$2
  _expr=${@[-1]}   # the expression is always the last arg
  # `frame ls` probes each socket with FrameInfo(). A test stands in for a live
  # session by planting a <sock>.info companion holding the answer; a socket
  # without one is "dead" — the query fails, exactly as a real unanswered
  # socket would, and ls skips it.
  case "$_expr" in
    *FrameInfo*)
      # A <sock>.hang companion stands in for an alive-but-unresponsive nvim:
      # the socket exists but the session never answers the RPC. Sleep well
      # past frame_rpc_expr's timeout so the caller must bound + skip us; a
      # real wedged frame would block here indefinitely. The client is killed
      # before this returns, so the exit code never matters.
      [[ -f "$_sock.hang" ]] && { sleep 30; exit 0; }
      [[ -f "$_sock.info" ]] && { cat "$_sock.info"; exit 0; }; exit 1 ;;
    # `frame spawn` polls FrameReady() while a worker boots. A test marks the
    # planted socket "booted" with a <sock>.ready companion; without one the
    # session answers 0 (still booting) and spawn keeps polling to its timeout.
    *FrameReady*) [[ -f "$_sock.ready" ]] && print -rn -- 1 || print -rn -- 0; exit 0 ;;
  esac
  # Optional expr trace: append every remote-expr issued, so a test can assert
  # what was actually sent (e.g. --count threading into FrameInboxDrainAtLeast).
  [[ -n "${FAKE_NVIM_EXPR_LOG:-}" ]] && print -r -- "$_expr" >> "$FAKE_NVIM_EXPR_LOG"
  # Other exprs (frame status / notify / req / deliver / inbox …): a test opts in
  # via FAKE_NVIM_EXPR_RESULT, which becomes the answer to any such query. The
  # +x test means set-BUT-empty still answers (empty string) — an empty inbox
  # returns '' successfully, distinct from "unset" which falls through to the
  # tripwire like everything else.
  if [[ -n "${FAKE_NVIM_EXPR_RESULT+x}" ]]; then
    # FAKE_NVIM_EXPR_EMPTY_POLLS=N: answer '' for the first N queries (count
    # kept across invocations in FAKE_NVIM_POLL_COUNT_FILE) before serving the
    # result — lets a test watch `inbox --wait` genuinely poll before the mail
    # "arrives", instead of hitting it on the first drain.
    if [[ -n "${FAKE_NVIM_EXPR_EMPTY_POLLS:-}" ]]; then
      _n=0
      [[ -f "${FAKE_NVIM_POLL_COUNT_FILE:?set with FAKE_NVIM_EXPR_EMPTY_POLLS}" ]] \
        && _n=$(<"$FAKE_NVIM_POLL_COUNT_FILE")
      _n=$((_n + 1))
      print -rn -- "$_n" > "$FAKE_NVIM_POLL_COUNT_FILE"
      (( _n <= FAKE_NVIM_EXPR_EMPTY_POLLS )) && exit 0
    fi
    print -rn -- "$FAKE_NVIM_EXPR_RESULT"
    exit 0
  fi
fi
if [[ -n "${FAKE_NVIM_LOG:-}" ]]; then
  {
    print -r -- "argv: $*"
    print -r -- "cwd: $PWD"
    env | grep -E '^(FRAME_|PORT=|PORT_PREFIX=|SERVER_CMD=|[A-Z0-9_]+_(API|VITE|HMR)_PORT=)' | sort
  } > "$FAKE_NVIM_LOG"
  exit 0
fi
print -r -- "✗ test stub: unexpected nvim invocation: nvim $*" >&2
exit 97
